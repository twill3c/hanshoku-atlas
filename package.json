{
  "name": "hanshoku-atlas",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "measure:gates": "vitest run tests/gates.test.ts --reporter=verbose",
    "verify:browser": "next build && node scripts/verify-browser.mjs",
    "core:bundle": "esbuild src/core/index.ts --bundle --format=esm --outfile=.cache/core.mjs --platform=neutral --log-level=warning",
    "frame": "python pipeline/build_frame.py",
    "fetch": "python pipeline/fetch_images.py",
    "analyze": "npm run core:bundle && node pipeline/analyze.mjs",
    "aggregate": "npm run core:bundle && node pipeline/aggregate.mjs",
    "artists": "npm run core:bundle && node pipeline/artists.mjs",
    "designs": "npm run core:bundle && node pipeline/designs.mjs"
  },
  "dependencies": {
    "next": "^15.5.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "playwright": "^1.62.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
